{
	// Standalone compile config for this package alone (`npm run build -w
	// core`). The repo consumes core straight from src/ via the workspace
	// exports map, so nothing in-repo depends on dist/ - what this config is
	// for is proving core still compiles on its own, which is the
	// publishability property tests/test_import_boundaries.py guards. It is
	// also a declared wheel build input (bobi/events/artifact.py).
	"compilerOptions": {
		"target": "es2022",
		// No runtime pin: core is runtime-agnostic (Node local server +
		// Cloudflare worker). DOM supplies the web-standard globals it uses
		// (fetch, crypto.subtle, TextEncoder).
		"lib": ["es2024", "dom"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
