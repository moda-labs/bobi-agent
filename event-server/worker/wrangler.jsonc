{
	"name": "bobi-events",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-26",
	"observability": {
		"enabled": true
	},
	"vars": {
		"BOBI_RELEASE_VERSION": "dev",
		"BOBI_RELEASE_SHA": "dev"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Required Cloudflare Worker secret:
	//   wrangler secret put INTERNAL_DO_SECRET
	// Inbound webhook verification secrets (#639) - unset admits that provider
	// unverified (counted on /health as webhook_unverified; whatsapp instead
	// fails closed); set all of these on a
	// shared/public server:
	//   wrangler secret put WEBHOOK_SECRET          (github X-Hub-Signature-256)
	//   wrangler secret put SLACK_SIGNING_SECRET    (global fallback; per-app secrets register via /slack/workspaces)
	//   wrangler secret put LINEAR_WEBHOOK_SECRET   (Linear-Signature)
	//   wrangler secret put WHATSAPP_APP_SECRET     (Meta X-Hub-Signature-256; unset = whatsapp rejects, fail-closed)
	//   wrangler secret put WHATSAPP_VERIFY_TOKEN   (Meta GET subscribe handshake)
	// Do not store these values in wrangler.jsonc, .env, Fly, Bubble, or agent-team env.
	// REQUIRED SETUP - this id is a placeholder and `wrangler deploy` will fail
	// until you replace it with your own namespace id:
	//   wrangler kv namespace create EVENTS
	// `bobi-events` above is a default name, not a reserved one; rename the
	// worker freely. See docs/EVENT_SERVER.md for the full deploy runbook.
	"kv_namespaces": [
		{
			"binding": "EVENTS",
			"id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEPLOYMENT_SESSION",
				"class_name": "DeploymentSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DeploymentSession"]
		}
	]
}
